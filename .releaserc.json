{
  "repositoryUrl": "https://github.com/quaz579/virtualtour.git",
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {"preset": "conventionalcommits"}],
    ["@semantic-release/release-notes-generator", {"preset": "conventionalcommits"}],
    ["@semantic-release/changelog", {"changelogFile": "packages/core/CHANGELOG.md", "changelogTitle": "# Changelog"}],
    ["@semantic-release/exec", {"prepareCmd": "node tools/release-prepare.mjs ${nextRelease.version}", "publishCmd": "node tools/release-publish.mjs ${nextRelease.version}"}],
    ["@semantic-release/git", {"assets": ["packages/core/package.json", "packages/react/package.json", "packages/vue/package.json", "package-lock.json", "packages/core/CHANGELOG.md"], "message": "chore(release): ${nextRelease.version} [skip ci]"}],
    "@semantic-release/github"
  ]
}
