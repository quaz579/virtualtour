{
  "name": "virtual-site-tour",
  "version": "1.0.3",
  "description": "Guided tours and onboarding for the web, forked from driver.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quaz579/virtualtour.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css",
    "./avatar.css": "./dist/avatar.css",
    "./thumbtack/pack.json": "./dist/thumbtack/pack.json",
    "./thumbtack/sheet.png": "./dist/thumbtack/sheet.png",
    "./thumbtack/round/pack.json": "./dist/thumbtack/round/pack.json",
    "./thumbtack/round/sheet.png": "./dist/thumbtack/round/sheet.png",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "STYLES.md",
    "ART.md"
  ],
  "scripts": {
    "build": "vite build && vite build --mode dev && node tools/build-dts.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p e2e/engine/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.11.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "rollup": "^4.68.7",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
