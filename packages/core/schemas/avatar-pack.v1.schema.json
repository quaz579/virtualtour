{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virtualtour-avatar-pack.v1.schema.json",
  "title": "VirtualTour avatar pack v1",
  "type": "object",
  "required": ["format", "name", "sheet", "animations", "roles"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "virtualtour-avatar/1" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "sheet": {
      "type": "object",
      "required": ["src", "frameWidth", "frameHeight"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "frameWidth": { "type": "number", "exclusiveMinimum": 0 },
        "frameHeight": { "type": "number", "exclusiveMinimum": 0 },
        "columns": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "pixelArt": { "type": "boolean" }
      }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/animation" }
    },
    "roles": {
      "type": "object",
      "required": ["rest"],
      "additionalProperties": false,
      "properties": {
        "rest": { "type": "string" },
        "idle": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }] },
        "greet": { "type": "string" },
        "think": { "type": "string" },
        "celebrate": { "type": "string" },
        "exit": { "type": "string" },
        "alert": { "type": "string" },
        "point": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": { "type": "string" },
            "right": { "type": "string" },
            "up": { "type": "string" },
            "down": { "type": "string" },
            "any": { "type": "string" }
          }
        }
      }
    },
    "bubble": {
      "type": "object",
      "properties": {
        "dock": { "enum": ["start", "end", "auto"] },
        "gap": { "type": "number" }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "attribution": { "type": "string" }
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["ms"],
      "properties": {
        "col": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "ms": { "type": "number", "exclusiveMinimum": 0 }
      },
      "oneOf": [
        { "required": ["col", "row"], "not": { "anyOf": [{ "required": ["x"] }, { "required": ["y"] }] } },
        { "required": ["x", "y"], "not": { "anyOf": [{ "required": ["col"] }, { "required": ["row"] }] } }
      ]
    },
    "animation": {
      "type": "object",
      "required": ["frames"],
      "additionalProperties": false,
      "properties": {
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame" } },
        "loop": { "type": "boolean" },
        "still": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
