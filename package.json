{
  "name": "virtualtour-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs",
    "demo"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspace virtualtour && npm run build --workspace virtualtour-react",
    "typecheck": "npm run typecheck --workspace virtualtour --workspace virtualtour-react",
    "test": "npm test --workspace virtualtour --workspace virtualtour-react",
    "e2e": "npm run e2e --workspace virtualtour",
    "size": "node packages/core/tools/size-report.mjs",
    "lint:prose": "node tools/lint-prose.mjs"
  }
}
