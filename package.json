{
  "name": "virtualtour-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs",
    "demo"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build --workspace virtualtour && npm run build --workspace virtualtour-react && npm run build --workspace virtualtour-vue",
    "typecheck": "npm run typecheck --workspace virtualtour --workspace virtualtour-react --workspace virtualtour-vue && npm run typecheck --workspace virtualtour-docs",
    "test": "npm test --workspace virtualtour --workspace virtualtour-react --workspace virtualtour-vue",
    "e2e": "npm run e2e --workspace virtualtour",
    "size": "node packages/core/tools/size-report.mjs",
    "lint:prose": "node tools/lint-prose.mjs",
    "docs:build": "npm run build --workspace virtualtour-docs",
    "docs:links": "node tools/check-links.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.2"
  }
}
